<?xml version="1.0" encoding="UTF-8"?><bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_04_validacao_qr_code" targetNamespace="https://github.com/corevent/documentation/bpmn" exporter="Corevent" exporterVersion="1.0"><bpmn:error id="Error_API" name="Falha na operação" errorCode="API_ERROR"/><bpmn:collaboration id="Collaboration"><bpmn:participant id="Pool_Corevent" name="Validação de QR Code e check-in" processRef="Process_04_validacao_qr_code"/></bpmn:collaboration><bpmn:process id="Process_04_validacao_qr_code" name="Validação de QR Code e check-in" isExecutable="false"><bpmn:documentation>Modelo funcional simplificado do Corevent.</bpmn:documentation><bpmn:laneSet id="LaneSet"><bpmn:lane id="Totem" name="Aplicativo · modo totem"><bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef><bpmn:flowNodeRef>Solicitar</bpmn:flowNodeRef><bpmn:flowNodeRef>Sucesso</bpmn:flowNodeRef><bpmn:flowNodeRef>Fim</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="API" name="API Corevent"><bpmn:flowNodeRef>Verificar</bpmn:flowNodeRef><bpmn:flowNodeRef>Valido</bpmn:flowNodeRef><bpmn:flowNodeRef>Registrar</bpmn:flowNodeRef><bpmn:flowNodeRef>Falha</bpmn:flowNodeRef><bpmn:flowNodeRef>Erro</bpmn:flowNodeRef><bpmn:flowNodeRef>ErroRegistro</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Inicio" name="QR Code lido"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="Solicitar" name="Enviar QR Code à API"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Verificar" name="Validar sessão, evento e ingresso"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Valido" name="Pode credenciar?" default="F5"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Registrar" name="Registrar check-in"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Sucesso" name="Exibir resultado e perfil"><bpmn:incoming>F6</bpmn:incoming><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Falha" name="Retornar motivo da falha"><bpmn:incoming>F5</bpmn:incoming><bpmn:incoming>F9</bpmn:incoming><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="Fim" name="Retornar à leitura"><bpmn:incoming>F7</bpmn:incoming></bpmn:endEvent><bpmn:boundaryEvent id="Erro" name="Falha de validação" attachedToRef="Verificar" cancelActivity="true"><bpmn:outgoing>F9</bpmn:outgoing><bpmn:errorEventDefinition id="Erro_def" errorRef="Error_API"/></bpmn:boundaryEvent><bpmn:boundaryEvent id="ErroRegistro" name="Falha no registro" attachedToRef="Registrar" cancelActivity="true"><bpmn:outgoing>F10</bpmn:outgoing><bpmn:errorEventDefinition id="ErroRegistro_def" errorRef="Error_API"/></bpmn:boundaryEvent><bpmn:sequenceFlow id="F1" sourceRef="Inicio" targetRef="Solicitar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F2" sourceRef="Solicitar" targetRef="Verificar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F3" sourceRef="Verificar" targetRef="Valido"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F4" sourceRef="Valido" targetRef="Registrar" name="Sim"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">validacaoAprovada</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="F5" sourceRef="Valido" targetRef="Falha" name="Não"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F6" sourceRef="Registrar" targetRef="Sucesso"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F7" sourceRef="Sucesso" targetRef="Fim"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F8" sourceRef="Falha" targetRef="Sucesso"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F9" sourceRef="Erro" targetRef="Falha"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F10" sourceRef="ErroRegistro" targetRef="Falha"></bpmn:sequenceFlow></bpmn:process><bpmndi:BPMNDiagram id="Diagram" name="Validação de QR Code e check-in"><bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration"><bpmndi:BPMNShape id="DI_Pool_Corevent" bpmnElement="Pool_Corevent" isHorizontal="true" bioc:fill="#FFFFFF" bioc:stroke="#64748B"><dc:Bounds x="90" y="180" width="1810" height="640"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Totem" bpmnElement="Totem" isHorizontal="true" bioc:fill="#FFFFFF" bioc:stroke="#64748B"><dc:Bounds x="120" y="180" width="1780" height="240"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_API" bpmnElement="API" isHorizontal="true" bioc:fill="#FFFFFF" bioc:stroke="#64748B"><dc:Bounds x="120" y="420" width="1780" height="400"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Inicio" bpmnElement="Inicio"  bioc:fill="#FFFFFF" bioc:stroke="#64748B"><dc:Bounds x="212" y="282" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="150" y="338" width="160" height="44"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Solicitar" bpmnElement="Solicitar"  bioc:fill="#FFFFFF" bioc:stroke="#64748B"><dc:Bounds x="340" y="257" width="160" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Verificar" bpmnElement="Verificar"  bioc:fill="#FFFFFF" bioc:stroke="#64748B"><dc:Bounds x="570" y="497" width="160" height="86"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Valido" bpmnElement="Valido" isMarkerVisible="true" bioc:fill="#FFF4EE" bioc:stroke="#64748B"><dc:Bounds x="875" y="515" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="800" y="584" width="200" height="44"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Registrar" bpmnElement="Registrar"  bioc:fill="#FFFFFF" bioc:stroke="#64748B"><dc:Bounds x="1060" y="497" width="160" hei