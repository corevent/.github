orizar" name="Validar acesso da equipe"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Acesso" name="Acesso autorizado?" default="F5"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="Negado" name="Acesso negado"><bpmn:incoming>F5</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Configurar" name="Selecionar evento"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Camera" name="Abrir câmera"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:serviceTask><bpmn:receiveTask id="Aguardar" name="Aguardar QR Code"><bpmn:incoming>F7</bpmn:incoming><bpmn:incoming>F9</bpmn:incoming><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:receiveTask><bpmn:subProcess id="Validar" name="Validar QR Code e exibir resultado"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing><bpmn:startEvent id="I_Start" name="QR capturado"><bpmn:outgoing>IF1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="I_API" name="Validar operador, evento, ingresso, pagamento e utilização"><bpmn:incoming>IF1</bpmn:incoming><bpmn:outgoing>IF2</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="I_Gate" name="Validação aprovada?" default="IF4"><bpmn:incoming>IF2</bpmn:incoming><bpmn:outgoing>IF3</bpmn:outgoing><bpmn:outgoing>IF4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="I_Register" name="Registrar check-in e identificar perfil"><bpmn:incoming>IF3</bpmn:incoming><bpmn:outgoing>IF5</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="I_OK" name="Exibir entrada autorizada e perfil"><bpmn:incoming>IF5</bpmn:incoming><bpmn:outgoing>IF6</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="I_Fail" name="Exibir falha e motivo sem autorizar entrada"><bpmn:incoming>IF4</bpmn:incoming><bpmn:incoming>IF8</bpmn:incoming><bpmn:incoming>IF9</bpmn:incoming><bpmn:outgoing>IF7</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="I_EndOK" name="Sucesso exibido"><bpmn:incoming>IF6</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="I_EndFail" name="Falha exibida"><bpmn:incoming>IF7</bpmn:incoming></bpmn:endEvent><bpmn:boundaryEvent id="I_APIFail" name="Falha de comunicação" attachedToRef="I_API" cancelActivity="true"><bpmn:outgoing>IF8</bpmn:outgoing><bpmn:errorEventDefinition id="I_APIFail_def" errorRef="Error_Inner"/></bpmn:boundaryEvent><bpmn:boundaryEvent id="I_RegisterFail" name="Falha no registro" attachedToRef="I_Register" cancelActivity="true"><bpmn:outgoing>IF9</bpmn:outgoing><bpmn:errorEventDefinition id="I_RegisterFail_def" errorRef="Error_Inner"/></bpmn:boundaryEvent><bpmn:sequenceFlow id="IF1" sourceRef="I_Start" targetRef="I_API"></bpmn:sequenceFlow><bpmn:sequenceFlow id="IF2" sourceRef="I_API" targetRef="I_Gate"></bpmn:sequenceFlow><bpmn:sequenceFlow id="IF3" sourceRef="I_Gate" targetRef="I_Register" name="Sim"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">validacaoAprovada</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="IF4" sourceRef="I_Gate" targetRef="I_Fail" name="Não"></bpmn:sequenceFlow><bpmn:sequenceFlow id="IF5" sourceRef="I_Register" targetRef="I_OK"></bpmn:sequenceFlow><bpmn:sequenceFlow id="IF6" sourceRef="I_OK" targetRef="I_EndOK"></bpmn:sequenceFlow><bpmn:sequenceFlow id="IF7" sourceRef="I_Fail" targetRef="I_EndFail"></bpmn:sequenceFlow><bpmn:sequenceFlow id="IF8" sourceRef="I_APIFail" targetRef="I_Fail"></bpmn:sequenceFlow><bpmn:sequenceFlow id="IF9" sourceRef="I_RegisterFail" targetRef="I_Fail"></bpmn:sequenceFlow></bpmn:subProcess><bpmn:boundaryEvent id="Saida" name="Saída solicitada" attachedToRef="Aguardar" cancelActivity="true"><bpmn:outgoing>F10</bpmn:outgoing><bpmn:conditionalEventDefinition id="Saida_def"><bpmn:condition xsi:type="bpmn:tFormalExpression">saidaSolicitada</bpmn:condition></bpmn:conditionalEventDefinition><